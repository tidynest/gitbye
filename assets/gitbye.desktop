[Desktop Entry]
Type=Application
Name=GitBye
GenericName=GitHub follow graph
Comment=Compare who you follow against who follows you back, and part with the rest
Exec=gitbye
Icon=gitbye
Terminal=false
Categories=Network;
Keywords=github;followers;following;unfollow;social;
# Must match the Wayland app id set in main.rs, or the compositor cannot pair
# the window with this entry and the icon falls back to a generic one.
StartupWMClass=gitbye
